{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/preparer-environnement.sh)",
      "Bash(bash scripts/preparer-environnement.sh *)",
      "Bash(bash scripts/tests.sh)",
      "Bash(bash scripts/test-dev-publier-version.sh)",
      "Bash(bash scripts/synchroniser-branche.sh)",
      "Bash(bash scripts/synchroniser-branche.sh *)",
      "Bash(bash scripts/resume-commande.sh *)",
      "Bash(bash scripts/tests/test-synchroniser-branche.sh)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(../.venv/bin/python -m pytest *)",
      "Bash(../.venv/bin/python -m app.contenu verifier)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(python -m app.contenu verifier)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm ci --no-audit --no-fund)",
      "Bash(npm audit --omit=dev --audit-level=high)",
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform validate)",
      "Bash(terraform version)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)"
