    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/tfplan)",
      "Read(**/*.tfplan)",
      "Read(**/*.tfvars)",
      "Read(**/.terraform/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/application_default_credentials.json)",
      "Read(**/*credentials*.json)",
      "Read(**/*service-account*.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.sql)",
      "Read(**/*.sql.gz)",
      "Read(**/*.dump)",
      "Read(**/*.pgdump)",
      "Read(**/*.backup)",
      "Read(**/sauvegardes/**)",
      "Edit(**/.env)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.*)",
      "Edit(**/.terraform.lock.hcl)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(bq *)",
      "Bash(terraform apply *)",
      "Bash(terraform apply)",
      "Bash(terraform destroy *)",
      "Bash(terraform destroy)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(terraform plan *)",
      "Bash(terraform plan)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform init -upgrade *)",
      "Bash(terraform providers lock *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * develop)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:develop)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git push *)",
      "Bash(terraform init *)"
    ]
